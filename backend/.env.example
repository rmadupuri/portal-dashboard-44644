# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:8080

# cBioPortal API
CBIOPORTAL_API_URL=https://www.cbioportal.org/api

# ClickHouse — read-only genomics analytics
# (using cgds_public_blue for now, but will check for production db color and switch in the future)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_DATABASE=cgds_public_blue
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# Postgres — app data (users + submissions)
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
# SSL: for managed/cloud Postgres set verify-full and point at the CA cert
# (path is relative to the backend/ directory). Leave both blank for local dev.
PGSSLMODE=verify-full
PGSSLROOTCERT=your-ca-certificate.pem
# PG_POOL_MAX=10

# Auth provider: "keycloak" (default) or "passport".
# Passport = Google/GitHub OAuth handled by this API; use it on test servers
# served over plain HTTP, where keycloak-js cannot run. Must match the
# frontend's VITE_AUTH_PROVIDER.
AUTH_PROVIDER=keycloak

# Keycloak (OIDC) — realm issuer; backend validates access tokens against its JWKS
# Keycloak 11 serves under the /auth context path; the default below matches
# keycloak/docker-compose.yml
KEYCLOAK_ISSUER=http://localhost:8081/auth/realms/dashboard
# Expected token audience (the client this API trusts). The realm in
# keycloak/realm-dashboard.json adds `dashboard-frontend` to access tokens.
KEYCLOAK_AUDIENCE=dashboard-frontend

# ─── Passport mode only (AUTH_PROVIDER=passport) ─────────────────────────────
# Signs the session tokens this API issues (use a long random string).
JWT_SECRET=
JWT_EXPIRE=7d
# Public URL of this API; OAuth callbacks are ${BACKEND_URL}/api/auth/<provider>/callback
BACKEND_URL=http://localhost:5001
# Set either pair, or both. GitHub OAuth apps accept http:// callbacks; Google
# accepts http:// only for localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated emails that get the super role (Keycloak mode uses the realm role instead)
SUPER_USER_EMAILS=
